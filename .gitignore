# ── generated builds inside archived snapshots ──────────────────────────
# The archives keep their source and README; the 10 MB inlined build of each
# is regenerable and would triple the repo for nothing.
Mockup/_Archive/**/*.built.html
Mockup/_Draft_1/*.built.html
Mockup/_Draft_2/*.built.html
Mockup/_Draft_2/models.packed.json

# ── source GLBs ─────────────────────────────────────────────────────────
# 18 MB of model sources. Models/models.packed.json is what the build consumes
# and is committed; keep the GLBs out unless someone needs to re-pack.
Models/glb/
Models/_Unused/

# stray screenshot, not part of the site
Screenshot*.png

# wrangler writes an account-id cache here when Pages commands are run
# from inside the repo. It is local state, not part of the site.
.wrangler/

# local probe builds
probe.html
*.bak

